# Media Renamer Environment Configuration
# Copy this file to .env and fill in your credentials

# Required: TMDb API credentials
# Get your API key from: https://www.themoviedb.org/settings/api
# Get your Read Access Token (Bearer) from the same page
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BEARER=your_tmdb_read_access_token_here

# Optional: TheTVDB v4 credentials (alternative TV metadata provider)
# Get from: https://thetvdb.com/api-information
THETVDB_API_KEY=your_tvdb_api_key_here
THETVDB_PIN=your_tvdb_pin_here

# Optional: Google Books API key (fallback for books; Open Library works without key)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Optional: Google Drive API key (only needed for very large public folders)
# Enable "Google Drive API" in Google Cloud and create an API key. Public folders can
# also be listed without a key. Private folders are not supported by .strm files.
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Optional: Default language for metadata (ISO 639-1 + region)
# Examples: es-MX, en-US, pt-BR, fr-FR, de-DE
DEFAULT_LANGUAGE=es-MX